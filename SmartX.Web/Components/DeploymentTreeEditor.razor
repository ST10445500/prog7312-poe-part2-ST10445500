@using SmartX.Web.Services

<div class="d-flex flex-wrap align-items-center gap-2 py-1 @(_isDropTarget ? "tree-drop-over" : "")"
     @ondragover:preventDefault="true"
     @ondragenter="DragEnter"
     @ondragleave="DragLeave"
     @ondrop="DropIntoAsync">

    @if (OnDragStart.HasDelegate)
    {
        <span class="tree-handle" draggable="true" @ondragstart="DragStartAsync" @ondragend="DragEnd">&#9776;</span>
    }

    <input class="form-control form-control-sm field-name" value="@Node.Name" @onchange="NameChangedAsync" />

    @if (Node.IsSensor)
    {
        <input class="form-control form-control-sm font-monospace field-narrow"
               list="@MacListId" value="@Node.SensorMacAddress" @onchange="MacChangedAsync" />
    }
    else
    {
        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="AddZoneAsync">+ Zone</button>
        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="AddSensorAsync">+ Sensor</button>
    }

    @if (OnRemove.HasDelegate)
    {
        <button type="button" class="btn btn-sm btn-outline-danger" title="Remove" @onclick="OnRemove">&times;</button>
    }
</div>

@if (!Node.IsSensor)
{
    <div class="ms-3 border-start ps-3">
        @foreach (var child in Node.Children)
        {
            <div class="tree-gap @(_gapBefore == child ? "tree-gap-over" : "")"
                 @ondragover:preventDefault="true"
                 @ondragenter="@(() => _gapBefore = child)"
                 @ondragleave="@(() => _gapBefore = null)"
                 @ondrop="@(() => DropBeforeAsync(child))"></div>

            <DeploymentTreeEditor @key="child"
                                  Node="child"
                                  MacListId="@MacListId"
                                  DefaultMacAddress="@DefaultMacAddress"
                                  OnChanged="OnChanged"
                                  OnDragStart="OnDragStart"
                                  OnDropInto="OnDropInto"
                                  OnDropBefore="OnDropBefore"
                                  OnRemove="@(() => RemoveChildAsync(child))" />
        }

        <div class="tree-gap @(_gapAtEnd ? "tree-gap-over" : "")"
             @ondragover:preventDefault="true"
             @ondragenter="@(() => _gapAtEnd = true)"
             @ondragleave="@(() => _gapAtEnd = false)"
             @ondrop="@(() => DropBeforeAsync(null))"></div>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public DeploymentNode Node { get; set; } = null!;

    [Parameter]
    public string MacListId { get; set; } = string.Empty;

    [Parameter]
    public string DefaultMacAddress { get; set; } = string.Empty;

    [Parameter]
    public EventCallback OnChanged { get; set; }

    [Parameter]
    public EventCallback<DeploymentNode> OnDragStart { get; set; }

    [Parameter]
    public EventCallback<DeploymentNode> OnDropInto { get; set; }

    [Parameter]
    public EventCallback<DeploymentDrop> OnDropBefore { get; set; }

    [Parameter]
    public EventCallback OnRemove { get; set; }

    private bool _isDropTarget;

    private DeploymentNode? _gapBefore;
    private bool _gapAtEnd;

    private async Task DropBeforeAsync(DeploymentNode? before)
    {
        _gapBefore = null;
        _gapAtEnd = false;

        await OnDropBefore.InvokeAsync(new DeploymentDrop { Zone = Node, Before = before });
    }

    private async Task DragStartAsync()
    {
        await OnDragStart.InvokeAsync(Node);
    }

    private void DragEnd()
    {
        _isDropTarget = false;
    }

    private void DragEnter()
    {
        _isDropTarget = !Node.IsSensor;
    }

    private void DragLeave()
    {
        _isDropTarget = false;
    }

    private async Task DropIntoAsync()
    {
        _isDropTarget = false;

        await OnDropInto.InvokeAsync(Node);
    }

    private async Task NameChangedAsync(ChangeEventArgs e)
    {
        Node.Name = e.Value?.ToString() ?? string.Empty;
        await OnChanged.InvokeAsync();
    }

    private async Task MacChangedAsync(ChangeEventArgs e)
    {
        Node.SensorMacAddress = e.Value?.ToString();
        await OnChanged.InvokeAsync();
    }

    private async Task AddZoneAsync()
    {
        Node.Children.Add(new DeploymentNode { Name = "New zone" });
        await OnChanged.InvokeAsync();
    }

    private async Task AddSensorAsync()
    {
        Node.Children.Add(new DeploymentNode
        {
            Name = "New sensor",
            SensorMacAddress = DefaultMacAddress
        });

        await OnChanged.InvokeAsync();
    }

    private async Task RemoveChildAsync(DeploymentNode child)
    {
        Node.Children.Remove(child);
        await OnChanged.InvokeAsync();
    }
}
