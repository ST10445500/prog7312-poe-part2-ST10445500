<div class="card mb-3">
    <div class="card-body">
        <h2 class="h6 mb-2">Suggested actions</h2>

        @if (Failed)
        {
            <div class="text-danger small">Could not load the suggestions.</div>
        }
        else if (Suggestions == null)
        {
            <div class="text-muted small">Loading...</div>
        }
        else if (Suggestions.Count == 0)
        {
            <div class="text-muted small">No suggestions yet. They appear once something happens on the stream.</div>
        }
        else
        {
            <ul class="list-group list-group-flush">
                @foreach (var suggestion in Suggestions)
                {
                    <li class="list-group-item px-0">
                        <div class="d-flex justify-content-between align-items-center">
                            <span>
                                <span class="badge @(suggestion.Kind == "Problem" ? "text-bg-danger" : "text-bg-primary") me-1">@suggestion.Kind</span>
                                @suggestion.Text
                                <span class="text-muted small ms-1">@((suggestion.Confidence * 100).ToString("0"))% sure</span>
                            </span>
                            @if (suggestion.MacAddress != null && suggestion.Open != null)
                            {
                                <button type="button" class="btn btn-sm btn-outline-primary" disabled="@Disabled"
                                        @onclick="() => OnApply.InvokeAsync(suggestion)">@(suggestion.Open == true ? "Open" : "Close")</button>
                            }
                        </div>
                        <div class="small text-muted">@suggestion.Reason</div>
                    </li>
                }
            </ul>
        }
    </div>
</div>

@code {
    // Null while the first load is still out.
    [Parameter]
    public List<Suggestion>? Suggestions { get; set; }

    [Parameter]
    public bool Failed { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback<Suggestion> OnApply { get; set; }
}
