<div class="card side-card">
    <div class="card-body">
        <h2 class="h6 mb-2">Suggested actions</h2>

        @if (Failed)
        {
            <div class="text-danger small">Could not load the suggestions.</div>
        }
        else if (Suggestions == null)
        {
            <div class="text-muted small">Loading...</div>
        }
        else if (Suggestions.Count == 0)
        {
            <div class="text-muted small">No suggestions yet. They appear once something happens on the stream.</div>
        }
        else
        {
            <ul class="list-group list-group-flush side-list">
                @foreach (var suggestion in Suggestions)
                {
                    <li class="list-group-item px-0">
                        <div class="d-flex justify-content-between align-items-center">
                            <span>
                                <span class="badge @(suggestion.Kind == "Problem" ? "text-bg-danger" : "text-bg-primary") me-1">@suggestion.Kind</span>
                                @suggestion.Text
                                <span class="text-muted small ms-1">@((suggestion.Confidence * 100).ToString("0"))% sure</span>
                            </span>
                            @if (ActionLabel(suggestion) is { } label)
                            {
                                <button type="button" class="btn btn-sm btn-outline-primary ms-2 text-nowrap" disabled="@(Disabled && ChangesValves(suggestion))"
                                        @onclick="() => OnApply.InvokeAsync(suggestion)">@label</button>
                            }
                        </div>
                        <div class="small text-muted">@suggestion.Reason</div>
                    </li>
                }
            </ul>
        }
    </div>
</div>

@code {
    // Null while the first load is still out.
    [Parameter]
    public List<Suggestion>? Suggestions { get; set; }

    [Parameter]
    public bool Failed { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback<Suggestion> OnApply { get; set; }

    // Says what the button does, or null when the suggestion is only a heads-up.
    private static string? ActionLabel(Suggestion suggestion)
    {
        if (suggestion.MacAddress != null && suggestion.Open != null)
        {
            return suggestion.Open == true ? "Open" : "Close";
        }

        if (suggestion.Kind == "Problem" && suggestion.MacAddress != null)
        {
            return "History";
        }

        if (suggestion.Event == "command:shutall")
        {
            return "Shut all";
        }

        if (suggestion.Event == "command:undo")
        {
            return "Undo";
        }

        return suggestion.Event.StartsWith("search:") ? "Search" : null;
    }

    // Looking at history or searching works with the api down, a valve change does not.
    private static bool ChangesValves(Suggestion suggestion)
    {
        return suggestion.Kind != "Problem" && !suggestion.Event.StartsWith("search:");
    }
}
