@page "/"

<PageTitle>Smart-X Gateway</PageTitle>

<PageHeader Title="Smart-X"
            Blurb="Telemetry gateway for sensor estates spread across sites that do not share a network." />

<div class="row g-3">
    <div class="col-12 col-md-4">
        <div class="card h-100">
            <div class="card-body d-flex flex-column">
                <span class="badge bg-primary align-self-start mb-2">Active</span>
                <h2 class="h6 card-title">Sensor Data Ingestion and Telemetry</h2>
                <p class="card-text text-muted small flex-grow-1">
                    Devices report in here. You can see what each one last sent, where
                    it sits, and what paperwork is filed against it.
                </p>
                <a class="btn btn-primary align-self-start" href="ingestion">Open</a>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card h-100">
            <div class="card-body d-flex flex-column">
                <span class="badge bg-secondary align-self-start mb-2">Coming soon</span>
                <h2 class="h6 card-title">Real-Time Command Stream and History</h2>
                <p class="card-text text-muted small flex-grow-1">
                    Send a command to a device and see what came back. Every manual
                    override is kept.
                </p>
                <button class="btn btn-primary align-self-start" disabled>Open</button>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card h-100">
            <div class="card-body d-flex flex-column">
                <span class="badge bg-secondary align-self-start mb-2">Coming soon</span>
                <h2 class="h6 card-title">Network Topology and Mesh Routing</h2>
                <p class="card-text text-muted small flex-grow-1">
                    How devices reach the gateway when they cannot reach it directly,
                    and which links a whole site is hanging off.
                </p>
                <button class="btn btn-primary align-self-start" disabled>Open</button>
            </div>
        </div>
    </div>
</div>
