@page "/"

<PageTitle>Smart-X Gateway</PageTitle>

<PageHeader Title="Smart-X"
            Blurb="A hybrid IoT telemetry gateway for monitoring distributed environments. Pick a pillar to get started." />

<div class="row g-3">
    <div class="col-12 col-md-4">
        <div class="card h-100">
            <div class="card-body d-flex flex-column">
                <span class="badge bg-primary align-self-start mb-2">Active</span>
                <h2 class="h6 card-title">Sensor Data Ingestion and Telemetry</h2>
                <p class="card-text text-muted small flex-grow-1">
                    Register sensors, watch their telemetry arrive, keep the deployment
                    tree in order and attach device files to a profile.
                </p>
                <a class="btn btn-primary align-self-start" href="ingestion">Open</a>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card h-100">
            <div class="card-body d-flex flex-column">
                <span class="badge bg-secondary align-self-start mb-2">Part 2</span>
                <h2 class="h6 card-title">Real-Time Command Stream and History</h2>
                <p class="card-text text-muted small flex-grow-1">
                    Live device commands, override history and predictive action
                    suggestions.
                </p>
                <button class="btn btn-primary align-self-start" disabled>Open</button>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card h-100">
            <div class="card-body d-flex flex-column">
                <span class="badge bg-secondary align-self-start mb-2">Part 3</span>
                <h2 class="h6 card-title">Network Topology and Mesh Routing</h2>
                <p class="card-text text-muted small flex-grow-1">
                    Mesh network view with routing and connectivity analysis across
                    the fleet.
                </p>
                <button class="btn btn-primary align-self-start" disabled>Open</button>
            </div>
        </div>
    </div>
</div>
