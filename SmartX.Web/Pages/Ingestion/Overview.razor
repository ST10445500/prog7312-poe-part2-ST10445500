@page "/ingestion"
@inject HttpClient Http
@implements IDisposable

<PageTitle>Ingestion Overview - Smart-X</PageTitle>

<PageHeader Title="Sensor Data Ingestion and Telemetry"
            Blurb="Live status for every device reporting into this gateway. Readings refresh every second.">
    <IngestionNav />
</PageHeader>

<ApiErrorAlert Show="_loadFailed" />

@if (_sensors == null && !_loadFailed)
{
    <LoadingBlock />
}
else if (_sensors is { Count: 0 })
{
    <EmptyState>
        No devices on this gateway yet. <a href="ingestion/fleet">Add one</a> and its readings will show up here.
    </EmptyState>
}
else if (_sensors != null)
{
    <div class="d-flex justify-content-end mb-2">
        @if (_lastUpdated != null)
        {
            <span class="text-muted small">
                <span class="live-dot me-1"></span>Updated @_lastUpdated.Value.ToLocalTime().ToString("HH:mm:ss")
            </span>
        }
    </div>

    <div class="row g-3 mb-4">
        <div class="col-6 col-lg">
            <StatTile Label="Devices" Value="@_sensors.Count.ToString()" Note="on this gateway" />
        </div>
        <div class="col-6 col-lg">
            <StatTile Label="Reporting" Value="@Count(TelemetryStatus.Normal).ToString()" Note="readings arriving steadily" />
        </div>
        <div class="col-6 col-lg">
            <StatTile Label="Sharp change" Value="@Count(TelemetryStatus.Spike).ToString()" Note="jumped between readings" ValueClass="@(Count(TelemetryStatus.Spike) > 0 ? "stat-value-warn" : "")" />
        </div>
        <div class="col-6 col-lg">
            <StatTile Label="Silent" Value="@Count(TelemetryStatus.Silent).ToString()" Note="nothing for 20 seconds" ValueClass="@(Count(TelemetryStatus.Silent) > 0 ? "stat-value-fault" : "")" />
        </div>
        <div class="col-12 col-lg">
            <StatTile Label="Total draw" Value="@(_fleetLoad?.TotalLoad ?? "-")" Note="@FleetLoadNote" />
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <h2 class="h5 card-title">Devices</h2>
            <p class="text-muted small">
                Anything that stopped reporting or jumped sharply is listed first.
            </p>

            <div class="row g-3">
                @foreach (var sensor in SortedSensors)
                {
                    <div class="col-12 col-lg-6">
                        <div class="d-flex justify-content-between align-items-start gap-2 mb-1">
                            <div>
                                <span class="fw-semibold">@sensor.Location.NodeId</span>
                                <span class="text-muted small ms-2">@SensorFormatting.DescribeLocation(sensor.Location)</span>
                            </div>
                            <div class="text-end">
                                <span class="font-monospace">@SensorFormatting.DescribeLatestReading(sensor)</span>
                                @if (StatusChip(sensor) != null)
                                {
                                    <div>
                                        <span class="status-chip @StatusChipClass(sensor)">@StatusChip(sensor)</span>
                                    </div>
                                }
                            </div>
                        </div>
                        <SignalRibbon Health="sensor.Health" />
                    </div>
                }
            </div>

            <div class="mt-4">
                <SignalTraceLegend />
            </div>
        </div>
    </div>
}

@code {
    private const int PollIntervalMilliseconds = 1000;

    private List<SensorOverview>? _sensors;
    private FleetLoad? _fleetLoad;
    private bool _loadFailed;
    private DateTime? _lastUpdated;
    private CancellationTokenSource? _polling;

    //every device, unhappy ones first
    private List<SensorOverview> SortedSensors =>
        _sensors?.OrderBy(sensor => StatusOrder(sensor.Health.Status))
            .ThenBy(sensor => sensor.Location.NodeId, StringComparer.OrdinalIgnoreCase)
            .ToList()
            ?? new List<SensorOverview>();

    private static int StatusOrder(TelemetryStatus status) => status switch
    {
        TelemetryStatus.Silent => 0,
        TelemetryStatus.Spike => 1,
        _ => 2
    };

    private static string? StatusChip(SensorOverview sensor) => sensor.Health.Status switch
    {
        TelemetryStatus.Silent => $"no readings, last {SensorFormatting.DescribeLastSeen(sensor.Health)}",
        TelemetryStatus.Spike => "sharp change",
        _ => null
    };

    private static string StatusChipClass(SensorOverview sensor) =>
        sensor.Health.Status == TelemetryStatus.Silent ? "status-chip-silent" : "status-chip-spike";

    private string FleetLoadNote =>
        _fleetLoad is { MetersReporting: > 0 }
            ? $"across {_fleetLoad.MetersReporting} {(_fleetLoad.MetersReporting == 1 ? "meter" : "meters")}"
            : "no meters reporting";

    private int Count(TelemetryStatus status)
    {
        return _sensors?.Count(sensor => sensor.Health.Status == status) ?? 0;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadOverviewAsync();

        _polling = new CancellationTokenSource();

        _ = PollAsync(_polling.Token);
    }

    private async Task PollAsync(CancellationToken token)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(PollIntervalMilliseconds));

        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                await LoadOverviewAsync();
                StateHasChanged();
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task LoadOverviewAsync()
    {
        try
        {
            var overview = Http.GetFromJsonAsync<List<SensorOverview>>("api/telemetry/overview", ApiJsonOptions.Default);
            var load = Http.GetFromJsonAsync<FleetLoad>("api/telemetry/load", ApiJsonOptions.Default);

            await Task.WhenAll(overview, load);

            _sensors = await overview;
            _fleetLoad = await load;
            _loadFailed = false;
            _lastUpdated = DateTime.UtcNow;
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException)
        {
            _loadFailed = true;
        }
    }

    public void Dispose()
    {
        _polling?.Cancel();
        _polling?.Dispose();
    }
}
