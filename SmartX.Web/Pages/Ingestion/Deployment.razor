@page "/ingestion/deployment"
@inject HttpClient Http
@using System.Text.Json

<PageTitle>Deployment - Smart-X</PageTitle>

<PageHeader Title="Deployment"
            Blurb="The site, zone and room tree the fleet sits in. The gateway walks the whole thing before it keeps anything, so a broken branch is caught at the level it goes wrong.">
    <IngestionNav />
</PageHeader>

<ApiErrorAlert Show="_loadFailed" />

<datalist id="@MacListId">
    @if (_sensors != null)
    {
        @foreach (var sensor in _sensors)
        {
            <option value="@sensor.MacAddress"></option>
        }
    }
</datalist>

<div class="card mb-4">
    <div class="card-body">
        @if (_editTree != null)
        {
            @if (UnplacedSensors.Count > 0)
            {
                <div class="alert alert-secondary">
                    <strong>Waiting to be placed</strong>
                    <p class="small mb-2">
                        Registered with the gateway but not in the deployment yet. Drag one
                        onto a zone below, or click it to drop it at the top level.
                    </p>

                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var sensor in UnplacedSensors)
                        {
                            <button class="btn btn-sm btn-outline-secondary"
                                    draggable="true"
                                    @ondragstart="() => StartDraggingUnplaced(sensor)"
                                    @onclick="() => PlaceSensor(sensor)">
                                @sensor.Location.NodeId
                                <span class="font-monospace ms-1 text-muted">@sensor.MacAddress</span>
                            </button>
                        }
                    </div>
                </div>
            }

            @if (_jsonMode)
            {
                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                    <span class="text-muted small">Try a sample tree:</span>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="LoadBrokenExample">
                        Broken tree
                    </button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="LoadDeepExample">
                        40 levels deep
                    </button>
                </div>

                <textarea class="form-control font-monospace" rows="12" @bind="_editJson"></textarea>

                <div class="mt-2">
                    <button class="btn btn-sm btn-outline-secondary me-2" @onclick="ApplyJson">Apply JSON</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="ShowBuilder">Back to builder</button>
                </div>

                @if (_jsonParseError != null)
                {
                    <div class="alert alert-danger mt-3">@_jsonParseError</div>
                }
            }
            else
            {
                <div class="border rounded p-3">
                    <DeploymentTreeEditor Node="_editTree"
                                          MacListId="@MacListId"
                                          DefaultMacAddress="@DefaultMacAddress"
                                          OnChanged="OnEditTreeChanged"
                                          OnDragStart="StartDrag"
                                          OnDropInto="DropIntoZone"
                                          OnDropBefore="DropBefore" />
                </div>

                <div class="mt-2">
                    <button class="btn btn-sm btn-outline-secondary" @onclick="ShowJson">Edit as JSON</button>
                </div>
            }

            <div class="d-flex flex-wrap gap-2 mt-3">
                <BusyButton CssClass="btn btn-outline-primary"
                            Label="Validate"
                            BusyLabel="Validating..."
                            Busy="_isValidating"
                            OnClick="ValidateEditAsync" />

                <BusyButton Label="Save"
                            BusyLabel="Saving..."
                            Busy="_isSaving"
                            Disabled="@(!_editValidated)"
                            OnClick="SaveDeploymentAsync" />

                <button class="btn btn-outline-secondary" @onclick="CancelEditing">Cancel</button>

                @if (!_editValidated)
                {
                    <span class="text-muted small align-self-center">
                        Validate the tree before it can be saved.
                    </span>
                }
            </div>

            @if (_editResult != null)
            {
                <div class="mt-3">
                    <span class="badge @(_editResult.IsValid ? "bg-success" : "bg-danger") me-2">
                        @(_editResult.IsValid ? "Valid" : "Rejected")
                    </span>
                    <span class="badge bg-secondary me-2">@_editResult.NodesChecked nodes checked</span>
                    <span class="badge bg-secondary me-2">deepest level @_editResult.DeepestLevel</span>
                    <span class="badge bg-secondary">@_editResult.SensorsFound sensors</span>

                    @if (_editResult.Errors.Count > 0)
                    {
                        <ul class="mt-3">
                            @foreach (var error in _editResult.Errors)
                            {
                                <li>@error</li>
                            }
                        </ul>
                    }
                </div>
            }

            @if (_editError != null)
            {
                <div class="alert alert-danger mt-3">@_editError</div>
            }
        }
        else if (_deploymentTree != null)
        {
            <DeploymentTreeNode Node="_deploymentTree" />

            <button class="btn btn-primary mt-3" @onclick="StartEditing">Edit deployment</button>
        }
        else if (!_loadFailed)
        {
            <LoadingBlock />
        }
    </div>
</div>

@code {
    private const string MacListId = "known-mac-addresses";

    private static readonly JsonSerializerOptions TreeDisplayOptions = new(ApiJsonOptions.Default) { WriteIndented = true };

    private List<SensorRegistration>? _sensors;
    private bool _loadFailed;

    private DeploymentNode? _deploymentTree;
    private DeploymentNode? _editTree;
    private DeploymentNode? _draggedNode;
    private DeploymentValidationResult? _editResult;
    private string? _editError;
    private bool _editValidated;
    private bool _isSaving;
    private bool _isValidating;
    private bool _jsonMode;
    private string _editJson = string.Empty;
    private string? _jsonParseError;

    private string DefaultMacAddress =>
        _sensors is { Count: > 0 } ? _sensors[0].MacAddress : "AA:BB:CC:DD:EE:FF";

    //the registered sensors the tree being edited does not place anywhere
    private List<SensorRegistration> UnplacedSensors
    {
        get
        {
            if (_editTree == null || _sensors == null)
            {
                return new List<SensorRegistration>();
            }

            var placed = DeploymentTreeOperations.MacAddressesIn(_editTree);

            return _sensors
                .Where(sensor => !placed.Contains(sensor.MacAddress))
                .ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadSensorsAsync();
        await LoadDeploymentAsync();
    }

    private async Task LoadSensorsAsync()
    {
        try
        {
            _sensors = await Http.GetFromJsonAsync<List<SensorRegistration>>("api/sensors", ApiJsonOptions.Default);
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException)
        {
            _loadFailed = true;
        }
    }

    private async Task LoadDeploymentAsync()
    {
        try
        {
            _deploymentTree = await Http.GetFromJsonAsync<DeploymentNode>("api/deployment", ApiJsonOptions.Default);
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException)
        {
            _loadFailed = true;
        }
    }

    private void StartEditing()
    {
        if (_deploymentTree == null)
        {
            return;
        }

        // Editing a copy is what lets Cancel simply throw the whole thing away.
        _editTree = DeploymentTreeOperations.Clone(_deploymentTree);
        _editResult = null;
        _editError = null;
        _editValidated = false;
    }

    private void CancelEditing()
    {
        _editTree = null;
        _editResult = null;
        _editError = null;
        _editValidated = false;
    }

    private void PlaceSensor(SensorRegistration sensor)
    {
        if (_editTree == null)
        {
            return;
        }

        // Clicking drops it at the top level, where it is easy to see and then drag
        // somewhere better. A sensor registered by name has no zone to go back to.
        _editTree.Children.Add(SensorLeafFor(sensor));
        OnEditTreeChanged();
    }

    private void StartDraggingUnplaced(SensorRegistration sensor)
    {
        // The leaf is built here rather than when it lands, so the drop handlers do
        // not have to care whether what they were given is already in the tree.
        _draggedNode = SensorLeafFor(sensor);
    }

    private static DeploymentNode SensorLeafFor(SensorRegistration sensor)
    {
        return new DeploymentNode
        {
            Name = sensor.Location.NodeId,
            SensorMacAddress = sensor.MacAddress
        };
    }

    private void OnEditTreeChanged()
    {
        // A pass describes the tree as it was when it was checked, so changing
        // anything afterwards has to put Save back out of reach.
        _editResult = null;
        _editValidated = false;
    }

    private void StartDrag(DeploymentNode node)
    {
        _draggedNode = node;
    }

    private void DropIntoZone(DeploymentNode zone)
    {
        if (_editTree == null || _draggedNode == null)
        {
            return;
        }

        if (DeploymentTreeOperations.MoveInto(_editTree, _draggedNode, zone))
        {
            OnEditTreeChanged();
        }

        _draggedNode = null;
    }

    private void DropBefore(DeploymentDrop drop)
    {
        if (_editTree == null || _draggedNode == null)
        {
            return;
        }

        if (DeploymentTreeOperations.MoveBefore(_editTree, _draggedNode, drop.Zone, drop.Before))
        {
            OnEditTreeChanged();
        }

        _draggedNode = null;
    }

    private async Task ValidateEditAsync()
    {
        if (_editTree == null)
        {
            return;
        }

        _editResult = null;
        _editError = null;
        _editValidated = false;
        _isValidating = true;

        try
        {
            var response = await Http.PostAsJsonAsync("api/deployment/validate", _editTree, ApiJsonOptions.Default);

            if (response.IsSuccessStatusCode)
            {
                _editResult = await response.Content.ReadFromJsonAsync<DeploymentValidationResult>(ApiJsonOptions.Default);
                _editValidated = _editResult is { IsValid: true };
            }
            else
            {
                _editError = await response.Content.ReadAsStringAsync();
            }
        }
        catch (HttpRequestException)
        {
            _editError = "Could not reach the gateway API.";
        }
        finally
        {
            _isValidating = false;
        }
    }

    private async Task SaveDeploymentAsync()
    {
        if (_editTree == null || !_editValidated)
        {
            return;
        }

        _editError = null;
        _isSaving = true;

        try
        {
            var response = await Http.PutAsJsonAsync("api/deployment", _editTree, ApiJsonOptions.Default);

            if (response.IsSuccessStatusCode)
            {
                _editTree = null;
                _editResult = null;
                _editValidated = false;

                await LoadDeploymentAsync();
            }
            else
            {
                // The gateway checks the tree again before it keeps anything, so a
                // refusal comes back as the same result shape the validate button
                // already knows how to show.
                _editResult = await response.Content.ReadFromJsonAsync<DeploymentValidationResult>(ApiJsonOptions.Default);
                _editValidated = false;

                if (_editResult == null)
                {
                    _editError = "The gateway would not accept that deployment.";
                }
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException)
        {
            _editError = "Could not reach the gateway API.";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void LoadBrokenExample()
    {
        _editJson = JsonSerializer.Serialize(DeploymentTreeBuilder.BuildBrokenExample(), TreeDisplayOptions);
        _jsonParseError = null;
    }

    private void LoadDeepExample()
    {
        _editJson = JsonSerializer.Serialize(DeploymentTreeBuilder.BuildDeepExample(), TreeDisplayOptions);
        _jsonParseError = null;
    }

    private void ShowJson()
    {
        if (_editTree == null)
        {
            return;
        }

        _editJson = JsonSerializer.Serialize(_editTree, TreeDisplayOptions);
        _jsonParseError = null;
        _jsonMode = true;
    }

    private void ShowBuilder()
    {
        // Anything typed since the last Apply is dropped on purpose, so there is
        // never a question of which of the two is the tree being edited.
        _jsonParseError = null;
        _jsonMode = false;
    }

    private void ApplyJson()
    {
        DeploymentNode? tree;

        try
        {
            tree = JsonSerializer.Deserialize<DeploymentNode>(_editJson, ApiJsonOptions.Default);
        }
        catch (JsonException problem)
        {
            _jsonParseError = $"That is not valid JSON. {problem.Message}";
            return;
        }

        if (tree == null)
        {
            _jsonParseError = "That is not valid JSON.";
            return;
        }

        _editTree = tree;
        _jsonParseError = null;
        _jsonMode = false;

        // Pasted json is a change like any other, so it has to be validated before
        // it can be saved.
        OnEditTreeChanged();
    }
}
