@page "/ingestion/files"
@using System.Net
@inject HttpClient Http

<PageTitle>Device Files - Smart-X</PageTitle>

<PageHeader Title="Device Files"
            Blurb="Paperwork filed against a device, usually a calibration certificate or an install photo. Encrypted at rest. 25 MB a file.">
    <IngestionNav />
</PageHeader>

@if (_loadFailed)
{
    <div class="alert alert-danger">
        Cannot reach the gateway. Readings on this page may be out of date.
    </div>
}

@if (_sensors is { Count: 0 })
{
    <div class="card mb-4">
        <div class="card-body text-center text-muted py-5">
            No devices on this gateway yet. <a href="ingestion/fleet">Add one</a> before attaching documents.
        </div>
    </div>
}
else
{
    <div class="card mb-4">
        <div class="card-body">
            <div class="mb-3">
                <label class="form-label">Device</label>
                <select class="form-select field-wide" value="@_attachmentsMac" @onchange="OnSensorChangedAsync">
                    @foreach (var sensor in SensorsByName)
                    {
                        <option value="@sensor.MacAddress">@SensorFormatting.DescribeSensor(sensor)</option>
                    }
                </select>
            </div>

            @if (SelectedSensor != null)
            {
                <h2 class="h6">Documents on @SensorFormatting.DescribeSensor(SelectedSensor)</h2>
            }

            @if (_attachments == null)
            {
                <div class="text-center text-muted py-4">
                    <div class="spinner-border spinner-border-sm me-2" role="status"></div>
                    Loading...
                </div>
            }
            else if (_attachments.Count == 0)
            {
                <div class="text-center text-muted py-4">Nothing attached to this device yet.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Document</th>
                                <th>Size</th>
                                <th>Uploaded</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var attachment in _attachments)
                            {
                                <tr>
                                    <td>@attachment.FileName</td>
                                    <td>@FormatFileSize(attachment.SizeInBytes)</td>
                                    <td>@attachment.UploadedAt.ToLocalTime().ToString("g")</td>
                                    <td class="text-end">
                                        @if (_pendingDeleteId == attachment.Id)
                                        {
                                            <span class="text-muted small me-2">Delete permanently?</span>
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDeleteAsync(attachment.Id)">Yes, delete</button>
                                            <button class="btn btn-sm btn-outline-secondary" @onclick="CancelDelete">Cancel</button>
                                        }
                                        else
                                        {
                                            <a class="btn btn-sm btn-outline-secondary" href="@DownloadUrl(attachment.Id)">Download</a>
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => RequestDelete(attachment.Id)">Delete</button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <hr />

            @if (_uploadSucceeded)
            {
                <div class="alert alert-success">Document attached.</div>
            }
            @if (_attachmentError != null)
            {
                <div class="alert alert-danger">@_attachmentError</div>
            }

            <div class="row g-3 align-items-end">
                <div class="col-12 col-md-8">
                    <label class="form-label">Attach a document</label>
                    <InputFile class="form-control" OnChange="OnFileSelected" />
                </div>
                <div class="col-12 col-md-4">
                    <BusyButton Label="Attach"
                                BusyLabel="Attaching..."
                                Busy="_isUploading"
                                Disabled="@(_selectedFile == null)"
                                OnClick="UploadAsync" />
                </div>
            </div>
        </div>
    </div>
}

@code {
    private const long MaxUploadBytes = 25 * 1024 * 1024;
    private const int AlertTimeoutMilliseconds = 3000;

    //longest error body worth showing as it came back
    private const int MaxErrorLength = 200;

    private List<SensorRegistration>? _sensors;
    private bool _loadFailed;

    private string _attachmentsMac = string.Empty;
    private List<AttachmentSummary>? _attachments;
    private string? _pendingDeleteId;
    private IBrowserFile? _selectedFile;
    private bool _isUploading;
    private bool _uploadSucceeded;
    private string? _attachmentError;

    //devices sorted by name for the dropdown
    private List<SensorRegistration> SensorsByName =>
        _sensors?.OrderBy(sensor => sensor.Location.NodeId, StringComparer.OrdinalIgnoreCase).ToList()
            ?? new List<SensorRegistration>();

    private SensorRegistration? SelectedSensor =>
        _sensors?.FirstOrDefault(sensor => sensor.MacAddress == _attachmentsMac);

    protected override async Task OnInitializedAsync()
    {
        await LoadSensorsAsync();

        if (SensorsByName.Count > 0)
        {
            _attachmentsMac = SensorsByName[0].MacAddress;
        }

        await LoadAttachmentsAsync();
    }

    private async Task LoadSensorsAsync()
    {
        try
        {
            _sensors = await Http.GetFromJsonAsync<List<SensorRegistration>>("api/sensors", ApiJsonOptions.Default);
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException)
        {
            _loadFailed = true;
        }
    }

    private async Task OnSensorChangedAsync(ChangeEventArgs e)
    {
        _attachmentsMac = e.Value?.ToString() ?? string.Empty;
        await LoadAttachmentsAsync();
    }

    private async Task LoadAttachmentsAsync()
    {
        // A confirm left open would point at a file that is no longer listed.
        _pendingDeleteId = null;

        if (string.IsNullOrEmpty(_attachmentsMac))
        {
            _attachments = new List<AttachmentSummary>();
            return;
        }

        try
        {
            _attachments = await Http.GetFromJsonAsync<List<AttachmentSummary>>($"api/sensors/{_attachmentsMac}/attachments", ApiJsonOptions.Default);
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException)
        {
            _attachments = new List<AttachmentSummary>();
        }
    }

    private string DownloadUrl(string attachmentId)
    {
        return $"{Http.BaseAddress}api/sensors/{_attachmentsMac}/attachments/{attachmentId}";
    }

    private void RequestDelete(string attachmentId)
    {
        _pendingDeleteId = attachmentId;
    }

    private void CancelDelete()
    {
        _pendingDeleteId = null;
    }

    private async Task ConfirmDeleteAsync(string attachmentId)
    {
        _pendingDeleteId = null;
        _attachmentError = null;

        try
        {
            var response = await Http.DeleteAsync($"api/sensors/{_attachmentsMac}/attachments/{attachmentId}");

            if (!response.IsSuccessStatusCode)
            {
                _attachmentError = await DescribeFailureAsync(response);
            }
        }
        catch (HttpRequestException)
        {
            _attachmentError = "Could not reach the gateway API.";
        }

        await LoadAttachmentsAsync();
    }

    //turns a failed response into something worth showing
    private static async Task<string> DescribeFailureAsync(HttpResponseMessage response)
    {
        if (response.StatusCode == HttpStatusCode.RequestEntityTooLarge)
        {
            return $"The gateway refused that file. The limit is {FormatFileSize(MaxUploadBytes)}.";
        }

        var body = await response.Content.ReadAsStringAsync();

        if (string.IsNullOrWhiteSpace(body) || body.Length > MaxErrorLength)
        {
            return $"The gateway refused that request ({(int)response.StatusCode}).";
        }

        return body;
    }

    private static string FormatFileSize(long bytes)
    {
        if (bytes < 1024)
        {
            return $"{bytes} B";
        }

        if (bytes < 1024 * 1024)
        {
            return $"{bytes / 1024.0:0.#} KB";
        }

        return $"{bytes / (1024.0 * 1024.0):0.#} MB";
    }

    //takes the chosen file if the browser handed over exactly one that fits
    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        _selectedFile = null;
        _uploadSucceeded = false;
        _attachmentError = null;

        // Reading e.File throws unless there is exactly one file.
        if (e.FileCount == 0)
        {
            return;
        }

        if (e.FileCount > 1)
        {
            _attachmentError = "One file at a time.";
            return;
        }

        var file = e.File;

        if (file.Size > MaxUploadBytes)
        {
            _attachmentError = $"That file is {FormatFileSize(file.Size)}, over the {FormatFileSize(MaxUploadBytes)} limit.";
            return;
        }

        _selectedFile = file;
    }

    private async Task UploadAsync()
    {
        if (_selectedFile == null)
        {
            return;
        }

        if (string.IsNullOrEmpty(_attachmentsMac))
        {
            _attachmentError = "Pick a device before attaching a document.";
            return;
        }

        _isUploading = true;
        _uploadSucceeded = false;
        _attachmentError = null;

        try
        {
            using var content = new MultipartFormDataContent();
            using var fileStream = _selectedFile.OpenReadStream(MaxUploadBytes);
            using var streamContent = new StreamContent(fileStream);
            content.Add(streamContent, "file", _selectedFile.Name);

            var response = await Http.PostAsync($"api/sensors/{_attachmentsMac}/attachments", content);

            if (response.IsSuccessStatusCode)
            {
                _uploadSucceeded = true;
                _selectedFile = null;
                await LoadAttachmentsAsync();
            }
            else
            {
                _attachmentError = await DescribeFailureAsync(response);
            }
        }
        catch (HttpRequestException)
        {
            _attachmentError = "Could not reach the gateway API.";
        }
        catch (IOException problem)
        {
            _attachmentError = $"That file could not be read. {problem.Message}";
        }
        finally
        {
            _isUploading = false;
        }

        await ClearUploadSuccessAsync();
    }

    private async Task ClearUploadSuccessAsync()
    {
        if (!_uploadSucceeded)
        {
            return;
        }

        // The alert needs a render between being set and being cleared.
        StateHasChanged();
        await Task.Delay(AlertTimeoutMilliseconds);
        _uploadSucceeded = false;
    }
}
