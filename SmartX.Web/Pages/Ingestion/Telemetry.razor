@page "/ingestion/telemetry"
@inject HttpClient Http
@implements IDisposable
@using SmartX.Web.Services

<PageTitle>Telemetry - Smart-X</PageTitle>

<div class="mb-4">
    <h2>Telemetry</h2>
    <p class="text-muted">
        Live readings from the fleet, refreshed every few seconds, with a Signal
        Trace ribbon showing what each sensor has been doing.
    </p>
</div>

@if (_loadFailed)
{
    <div class="alert alert-danger">
        Could not reach the gateway API. Make sure SmartX.Api is running.
    </div>
}
else if (_sensors == null)
{
    <LoadingBlock />
}
else if (_sensors.Count == 0)
{
    <div class="card mb-4">
        <div class="card-body text-center text-muted py-5">
            No sensors registered yet. <a href="ingestion/sensors">Register one</a> to get started.
        </div>
    </div>
}
else
{
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <FleetSummary Sensors="_sensors" Load="_fleetLoad" />

        @if (_lastUpdated != null)
        {
            <span class="text-muted small">
                <span class="live-dot me-1"></span>Updated @_lastUpdated.Value.ToLocalTime().ToString("HH:mm:ss")
            </span>
        }
    </div>

    <div class="row g-3 mb-4">
        @foreach (var sensor in _sensors)
        {
            <div class="col-12 col-lg-6">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <h6 class="mb-0">@sensor.Location.NodeId</h6>
                                <span class="text-muted small font-monospace">@sensor.MacAddress</span>
                                <span class="text-muted small">@DescribeLocation(sensor)</span>
                            </div>
                            <span class="badge text-bg-secondary">@sensor.Category</span>
                        </div>

                        <div class="mb-3">
                            <span class="fs-4 font-monospace">@FormatLatestReading(sensor)</span>
                            @if (sensor.LatestRecordedAt != null)
                            {
                                <span class="text-muted small ms-2">@sensor.LatestRecordedAt.Value.ToLocalTime().ToString("g")</span>
                            }
                        </div>

                        <SignalRibbon Health="sensor.Health" />
                    </div>
                </div>
            </div>
        }
    </div>
}

@if (_sensors is { Count: > 0 })
{
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">Record a Test Reading</h5>
            <p class="text-muted small">
                The simulator reports for the fleet on its own, and this posts one reading
                by hand through the same <code>/api/telemetry</code> endpoint it and a real
                device both use.
            </p>

            @if (_readingSucceeded)
            {
                <div class="alert alert-success">Reading recorded.</div>
            }
            @if (_readingError != null)
            {
                <div class="alert alert-danger">@_readingError</div>
            }

            <div class="row g-3 align-items-end">
                <div class="col-12 col-md-4">
                    <label class="form-label">Sensor</label>
                    <select class="form-select" @bind="_selectedMac">
                        @foreach (var sensor in _sensors)
                        {
                            <option value="@sensor.MacAddress">@sensor.MacAddress (@sensor.Category)</option>
                        }
                    </select>
                </div>

                @if (SelectedCategory is SensorCategory.Environmental or SensorCategory.PowerConsumption)
                {
                    <div class="col-12 col-md-4">
                        <label class="form-label">
                            @(SelectedCategory == SensorCategory.Environmental ? "Value (%)" : "Value (W)")
                        </label>
                        <input type="number" class="form-control" @bind="_testValue" @bind:event="oninput" />
                    </div>
                }
                else if (SelectedCategory == SensorCategory.Actuator)
                {
                    <div class="col-12 col-md-4">
                        <label class="form-label">State</label>
                        <select class="form-select" @bind="_testState">
                            <option value="@(true)">Open</option>
                            <option value="@(false)">Closed</option>
                        </select>
                    </div>
                }

                <div class="col-12 col-md-4">
                    <button class="btn btn-primary" @onclick="RecordTestReadingAsync" disabled="@(_isSubmittingReading || ValueProblem != null)">
                        @if (_isSubmittingReading)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        @(_isSubmittingReading ? "Recording..." : "Record Reading")
                    </button>
                </div>

                @if (ValueProblem != null)
                {
                    <div class="col-12">
                        <span class="validation-message">@ValueProblem</span>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    private const int PollIntervalMilliseconds = 4000;
    private const int AlertTimeoutMilliseconds = 3000;

    private List<SensorOverview>? _sensors;
    private FleetLoad? _fleetLoad;
    private bool _loadFailed;
    private DateTime? _lastUpdated;
    private System.Timers.Timer? _pollTimer;

    private string _selectedMac = string.Empty;
    private double? _testValue;
    private bool _testState;
    private bool _isSubmittingReading;
    private bool _readingSucceeded;
    private string? _readingError;

    private SensorCategory? SelectedCategory =>
        _sensors?.FirstOrDefault(sensor => sensor.MacAddress == _selectedMac)?.Category;

    //describes what is wrong with the typed value, or null when it is ready to post
    private string? ValueProblem
    {
        get
        {
            // An actuator carries a state rather than a number, and the dropdown
            // cannot be left empty, so there is nothing to check.
            if (SelectedCategory == SensorCategory.Actuator)
            {
                return null;
            }

            if (_testValue == null)
            {
                return "Enter a reading first.";
            }

            // These are the same bounds TelemetryController enforces, checked here
            // so the gateway never has to turn the reading away.
            if (SelectedCategory == SensorCategory.Environmental && _testValue is < 0 or > 100)
            {
                return "A moisture reading has to be between 0 and 100 percent.";
            }

            if (SelectedCategory == SensorCategory.PowerConsumption && _testValue < 0)
            {
                return "A power meter cannot draw less than nothing.";
            }

            return null;
        }
    }

    //describes where a sensor sits, or says so when it is not in the tree yet
    private static string DescribeLocation(SensorOverview sensor)
    {
        if (string.IsNullOrWhiteSpace(sensor.Location.Zone))
        {
            return "Not placed";
        }

        if (string.Equals(sensor.Location.Zone, sensor.Location.Room, StringComparison.OrdinalIgnoreCase))
        {
            return sensor.Location.Zone;
        }

        return $"{sensor.Location.Zone} / {sensor.Location.Room}";
    }

    private static string FormatLatestReading(SensorOverview sensor)
    {
        // TelemetryUsage formats a reading with the reading struct's own ToString,
        // which for a plain bool gives True/False rather than the open/closed
        // wording the rest of the app uses for actuators.
        if (sensor.Category == SensorCategory.Actuator && sensor.LatestReading != null)
        {
            return sensor.LatestReading == "True" ? "Open" : "Closed";
        }

        return sensor.LatestReading ?? "-";
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadOverviewAsync();

        _pollTimer = new System.Timers.Timer(PollIntervalMilliseconds);
        _pollTimer.Elapsed += async (_, _) => await InvokeAsync(async () =>
        {
            await LoadOverviewAsync();
            StateHasChanged();
        });
        _pollTimer.AutoReset = true;
        _pollTimer.Start();
    }

    private async Task LoadOverviewAsync()
    {
        try
        {
            _sensors = await Http.GetFromJsonAsync<List<SensorOverview>>("api/telemetry/overview", ApiJsonOptions.Default);
            _fleetLoad = await Http.GetFromJsonAsync<FleetLoad>("api/telemetry/load", ApiJsonOptions.Default);
            _loadFailed = false;
            _lastUpdated = DateTime.UtcNow;

            // Keeps a sensor selected in the test-reading form once the fleet has
            // loaded, rather than leaving the dropdown on a blank first option.
            if (string.IsNullOrEmpty(_selectedMac) && _sensors is { Count: > 0 })
            {
                _selectedMac = _sensors[0].MacAddress;
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException)
        {
            _loadFailed = true;
        }
    }

    private async Task RecordTestReadingAsync()
    {
        _isSubmittingReading = true;
        _readingSucceeded = false;
        _readingError = null;

        try
        {
            var reading = SelectedCategory == SensorCategory.Actuator
                ? new TestReading(_selectedMac, null, _testState)
                : new TestReading(_selectedMac, _testValue, null);

            var response = await Http.PostAsJsonAsync("api/telemetry", reading, ApiJsonOptions.Default);

            if (response.IsSuccessStatusCode)
            {
                _readingSucceeded = true;
                await LoadOverviewAsync();
            }
            else
            {
                _readingError = await response.Content.ReadAsStringAsync();
            }
        }
        catch (HttpRequestException)
        {
            _readingError = "Could not reach the gateway API.";
        }
        finally
        {
            _isSubmittingReading = false;
        }

        await ClearReadingSuccessAsync();
    }

    private async Task ClearReadingSuccessAsync()
    {
        if (!_readingSucceeded)
        {
            return;
        }

        // Without this render the flag would be set and cleared inside one pass,
        // so the alert would never actually appear.
        StateHasChanged();
        await Task.Delay(AlertTimeoutMilliseconds);
        _readingSucceeded = false;
    }

    public void Dispose()
    {
        _pollTimer?.Dispose();
    }

    private record TestReading(string MacAddress, double? Value, bool? State);
}
