@page "/commandstream"
@inject HttpClient Http
@inject DashboardState State
@implements IDisposable

<PageTitle>Command Stream - Smart-X</PageTitle>

<PageHeader Title="Command Stream"
            Blurb="Readings as they come off the queue, and the overrides sent back to devices." />

@if (_loadFailed)
{
    <div class="alert alert-danger">
        Cannot reach the gateway. What is shown may be out of date.
    </div>
}

<div class="row g-2 mb-3 align-items-center">
    <div class="col-12 col-md">
        <input class="form-control font-monospace" placeholder="Search by MAC address" @bind="State.SearchText" @bind:event="oninput" />
    </div>
    <div class="col-6 col-md-auto">
        <select class="form-select" @bind="CategoryText">
            <option value="">All categories</option>
            @foreach (var category in Enum.GetValues<SensorCategory>())
            {
                <option value="@category">@category</option>
            }
        </select>
    </div>
    <div class="col-6 col-md-auto">
        <div class="form-check">
            <input id="alertsOnly" class="form-check-input" type="checkbox" @bind="State.AlertsOnly" />
            <label class="form-check-label" for="alertsOnly">Alerts only</label>
        </div>
    </div>
    <div class="col-12 col-md-auto">
        @if (State.Connected)
        {
            <span class="badge text-bg-success">Live</span>
        }
        else
        {
            <span class="badge text-bg-secondary">Polling</span>
        }
    </div>
</div>

@if (_snapshot == null && !_loadFailed)
{
    <div class="text-center text-muted py-4">
        <div class="spinner-border spinner-border-sm me-2" role="status"></div>
        Loading...
    </div>
}
else if (_snapshot != null)
{
    <div class="row g-3 mb-3">
        <div class="col-6 col-md-3">
            <StatTile Label="Queue depth" Value="@_snapshot.QueueDepth.ToString()" Note="packets waiting" />
        </div>
        <div class="col-6 col-md-3">
            <StatTile Label="Alert queue" Value="@_snapshot.AlertDepth.ToString()" Note="alerts waiting" />
        </div>
        <div class="col-6 col-md-3">
            <StatTile Label="Alerts raised" Value="@_snapshot.AlertsRaised.ToString()" Note="since the api started" />
        </div>
        <div class="col-6 col-md-3">
            <StatTile Label="Packets jumped" Value="@_snapshot.PacketsJumped.ToString()" Note="overtaken by alerts" />
        </div>
        <div class="col-6 col-md-3">
            <StatTile Label="Active faults" Value="@_snapshot.ActiveErrors.ToString()" Note="reported and not cleared" />
        </div>
        <div class="col-6 col-md-3">
            <StatTile Label="Suppressed" Value="@_snapshot.SuppressedDuplicates.ToString()" Note="repeat faults not alerted" />
        </div>
        <div class="col-6 col-md-3">
            <StatTile Label="Disconnected" Value="@_snapshot.DisconnectedNodes.Count.ToString()" Note="gone quiet" />
        </div>
        <div class="col-6 col-md-3">
            <StatTile Label="Devices" Value="@_snapshot.Devices.Count.ToString()" Note="seen on the stream" />
        </div>
        <div class="col-6 col-md-3">
            <StatTile Label="Undo stack" Value="@_snapshot.UndoDepth.ToString()" Note="overrides that can be undone" />
        </div>
    </div>

    @if (_snapshot.DisconnectedNodes.Count > 0)
    {
        <div class="alert alert-warning">No packets from @string.Join(", ", _snapshot.DisconnectedNodes).</div>
    }

    @if (_commandMessage != null)
    {
        <div class="alert @(_commandFailed ? "alert-danger" : "alert-success")">@_commandMessage</div>
    }

    <div class="mb-3">
        <BusyButton CssClass="btn btn-outline-secondary btn-sm"
                    Label="Undo last override"
                    BusyLabel="Undoing..."
                    Busy="_isSending"
                    OnClick="UndoAsync" />
        <BusyButton CssClass="btn btn-outline-danger btn-sm ms-2"
                    Label="Shut all valves"
                    BusyLabel="Closing..."
                    Busy="_isSending"
                    OnClick="ShutAllAsync" />
    </div>

    @if (_snapshot.Devices.Count == 0)
    {
        <div class="card">
            <div class="card-body text-center text-muted py-5">
                @if (!string.IsNullOrWhiteSpace(State.SearchText))
                {
                    <span>No devices match "@State.SearchText".</span>
                }
                else if (State.Category != null || State.AlertsOnly)
                {
                    <span>No devices match the filters.</span>
                }
                else
                {
                    <span>No devices have reported yet. Start the simulator and they will show up here.</span>
                }
            </div>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Device</th>
                        <th>Mac Address</th>
                        <th>Latest</th>
                        <th>RSSI</th>
                        <th>Hops</th>
                        <th>Protocol</th>
                        <th>Last seen</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var device in _snapshot.Devices)
                    {
                        <tr>
                            <td>@device.Name</td>
                            <td class="font-monospace">@device.MacAddress</td>
                            <td class="font-monospace">@device.Reading</td>
                            <td>@(device.Radio.Rssi?.ToString() ?? "-") dBm</td>
                            <td>@(device.Radio.HopCount?.ToString() ?? "-")</td>
                            <td>@(device.Radio.Protocol ?? "-")</td>
                            <td class="text-muted small">@device.LastSeen.ToLocalTime().ToString("HH:mm:ss")</td>
                            <td class="text-end">
                                <button type="button" class="btn btn-sm btn-outline-secondary"
                                        @onclick="() => ShowHistoryAsync(device.MacAddress)">History</button>
                                @if (device.Category == SensorCategory.Actuator)
                                {
                                    <button type="button" class="btn btn-sm btn-primary" disabled="@_isSending"
                                            @onclick="() => SendAsync(device.MacAddress, true)">Open</button>
                                    <button type="button" class="btn btn-sm btn-outline-primary" disabled="@_isSending"
                                            @onclick="() => SendAsync(device.MacAddress, false)">Close</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (_historyMac != null)
    {
        <div class="card mb-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h2 class="h6 mb-0">History for <span class="font-monospace">@_historyMac</span></h2>
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CloseHistory">Close</button>
                </div>

                @if (_historyFailed)
                {
                    <div class="alert alert-danger mb-0">Could not load the history for this device.</div>
                }
                else if (_history == null)
                {
                    <div class="text-muted">Loading...</div>
                }
                else if (_history.Count == 0)
                {
                    <div class="text-muted">No readings kept for this device yet.</div>
                }
                else
                {
                    <div class="mb-2 text-primary">
                        <Sparkline Values="_historyValues" />
                    </div>
                    <div class="small text-muted mb-2">Newest @Math.Min(_history.Count, HistoryRows) of @_history.Count kept.</div>
                    <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <thead>
                                <tr>
                                    <th>Recorded</th>
                                    <th>Reading</th>
                                    <th>RSSI</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var point in _history.AsEnumerable().Reverse().Take(HistoryRows))
                                {
                                    <tr>
                                        <td class="text-muted small">@point.RecordedAt.ToLocalTime().ToString("HH:mm:ss")</td>
                                        <td class="font-monospace">@point.Reading</td>
                                        <td>@(point.Rssi?.ToString() ?? "-") dBm</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }
}

@code {
    private const int PollIntervalMilliseconds = 1000;
    private const int HistoryRows = 15;

    private StreamSnapshot? _snapshot;
    private bool _loadFailed;
    private CancellationTokenSource? _polling;

    private bool _isSending;
    private bool _commandFailed;
    private string? _commandMessage;

    private string? _historyMac;
    private List<HistoryPoint>? _history;
    private List<double> _historyValues = new();
    private bool _historyFailed;

    // The select works in text, the state holds the category itself.
    private string CategoryText
    {
        get => State.Category?.ToString() ?? string.Empty;
        set => State.Category = Enum.TryParse<SensorCategory>(value, out var category) ? category : null;
    }

    protected override async Task OnInitializedAsync()
    {
        State.OnChange += OnStateChanged;
        State.OnStreamChanged += OnStateChanged;

        await LoadSnapshotAsync();

        _polling = new CancellationTokenSource();

        _ = PollAsync(_polling.Token);

        // Opened after the first load so a slow hub never holds the page up.
        await State.StartAsync();
    }

    // The poll stays as the fallback, and it is also what tries the hub again after the api was down.
    private async Task PollAsync(CancellationToken token)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(PollIntervalMilliseconds));

        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                if (!State.Connected)
                {
                    await State.StartAsync();
                }

                await ReloadAsync();
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    // Loads the list again, and the open history with it, then redraws.
    private async Task ReloadAsync()
    {
        await LoadSnapshotAsync();

        if (_historyMac != null)
        {
            await LoadHistoryAsync();
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task ShowHistoryAsync(string macAddress)
    {
        _historyMac = macAddress;
        _history = null;
        _historyFailed = false;

        await LoadHistoryAsync();
    }

    private void CloseHistory()
    {
        _historyMac = null;
        _history = null;
    }

    private async Task LoadHistoryAsync()
    {
        var mac = _historyMac;

        try
        {
            var points = await Http.GetFromJsonAsync<List<HistoryPoint>>($"api/stream/devices/{Uri.EscapeDataString(mac!)}/history", ApiJsonOptions.Default);

            // The card may have been closed or switched while the call was out.
            if (mac != _historyMac)
            {
                return;
            }

            _history = points ?? new List<HistoryPoint>();
            _historyValues = _history.Select(ReadingValue).ToList();
            _historyFailed = false;
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException)
        {
            _historyFailed = true;
        }
    }

    // A valve has no number in its reading, so open is 1 and closed is 0.
    private static double ReadingValue(HistoryPoint point)
    {
        if (point.State != null)
        {
            return point.State.Value ? 1 : 0;
        }

        var digits = new string(point.Reading.TakeWhile(c => char.IsDigit(c) || c == '.' || c == '-').ToArray());

        return double.TryParse(digits, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var value) ? value : 0;
    }

    private async Task LoadSnapshotAsync()
    {
        try
        {
            var url = $"api/stream/snapshot?search={Uri.EscapeDataString(State.SearchText)}&alertsOnly={State.AlertsOnly.ToString().ToLowerInvariant()}";

            if (State.Category != null)
            {
                url += $"&category={State.Category}";
            }

            _snapshot = await Http.GetFromJsonAsync<StreamSnapshot>(url, ApiJsonOptions.Default);
            _loadFailed = false;
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException)
        {
            _loadFailed = true;
        }
    }

    private async Task SendAsync(string macAddress, bool open)
    {
        var request = new PumpCommandRequest { MacAddress = macAddress, Open = open };

        await PostCommandAsync(() => Http.PostAsJsonAsync("api/commands", request, ApiJsonOptions.Default));
    }

    private async Task ShutAllAsync()
    {
        await PostCommandAsync(() => Http.PostAsync("api/commands/close-all", null));
    }

    private async Task UndoAsync()
    {
        await PostCommandAsync(() => Http.PostAsync("api/commands/undo", null));
    }

    private async Task PostCommandAsync(Func<Task<HttpResponseMessage>> post)
    {
        _isSending = true;
        _commandFailed = false;

        try
        {
            var response = await post();

            _commandMessage = await response.Content.ReadAsStringAsync();
            _commandFailed = !response.IsSuccessStatusCode;

            await LoadSnapshotAsync();
        }
        catch (HttpRequestException)
        {
            _commandMessage = "Could not reach the gateway API.";
            _commandFailed = true;
        }
        finally
        {
            _isSending = false;
        }
    }

    // A filter changed or the api pushed, so the list is asked for again straight away.
    private void OnStateChanged()
    {
        _ = ReloadAsync();
    }

    public void Dispose()
    {
        State.OnChange -= OnStateChanged;
        State.OnStreamChanged -= OnStateChanged;
        _polling?.Cancel();
        _polling?.Dispose();
    }
}
