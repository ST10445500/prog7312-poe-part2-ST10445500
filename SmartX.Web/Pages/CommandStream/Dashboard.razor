@page "/commandstream"
@inject HttpClient Http
@inject DashboardState State
@inject IConfiguration Config
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Command Stream - Smart-X</PageTitle>

<PageHeader Title="Command Stream"
            Blurb="Readings as they come off the queue, and the overrides sent back to devices." />

@if (_loadFailed)
{
    <div class="alert alert-danger">
        @if (_snapshot != null)
        {
            <span>Cannot reach the gateway. Showing what it last sent at @_snapshot.TakenAt.ToLocalTime().ToString("HH:mm:ss"). Overrides are off until it is back.</span>
        }
        else
        {
            <span>Cannot reach the gateway. Nothing has loaded yet.</span>
        }
    </div>
}

<div class="stream-page">
<div class="stream-main">
<div class="stream-toolbar mb-3">
    <div class="row g-2 align-items-center">
        <div class="col-12 col-md">
            <input class="form-control font-monospace" placeholder="Search by MAC address, part of one is fine" @bind="State.SearchText" @bind:event="oninput" />
        </div>
        <div class="col-6 col-md-auto">
            <select class="form-select" @bind="CategoryText">
                <option value="">All categories</option>
                @foreach (var category in Enum.GetValues<SensorCategory>())
                {
                    <option value="@category">@category</option>
                }
            </select>
        </div>
        <div class="col-6 col-md-auto">
            <div class="form-check">
                <input id="alertsOnly" class="form-check-input" type="checkbox" @bind="State.AlertsOnly" />
                <label class="form-check-label" for="alertsOnly">Alerts only</label>
            </div>
        </div>
        <div class="col-12 col-md-auto d-flex align-items-center gap-2">
            @if (FiltersSet)
            {
                <button type="button" class="btn btn-link btn-sm p-0" @onclick="ClearFilters">Clear filters</button>
            }
            @if (State.Connected)
            {
                <span class="badge text-bg-success" title="The gateway pushes changes as they happen.">Live</span>
            }
            else
            {
                <span class="badge text-bg-secondary" title="Asking the gateway for updates every second or so.">Polling</span>
            }
        </div>
    </div>
</div>

<div class="stream-body">
@if (_snapshot == null && !_loadFailed)
{
    <div class="text-center text-muted py-4">
        <div class="spinner-border spinner-border-sm me-2" role="status"></div>
        Loading...
    </div>
}
else if (_snapshot != null)
{
    <div class="row g-3 mb-2">
        <div class="col-6 col-md-3">
            <StatTile Label="Devices" Value="@_snapshot.Devices.Count.ToString()" Note="seen on the stream" />
        </div>
        <div class="col-6 col-md-3">
            <StatTile Label="Queue depth" Value="@_snapshot.QueueDepth.ToString()" Note="packets waiting" />
        </div>
        <div class="col-6 col-md-3">
            <StatTile Label="Active faults" Value="@_snapshot.ActiveErrors.ToString()" Note="reported and not cleared"
                      ValueClass="@(_snapshot.ActiveErrors > 0 ? "stat-value-fault" : string.Empty)" />
        </div>
        <div class="col-6 col-md-3">
            <StatTile Label="Disconnected" Value="@_snapshot.DisconnectedNodes.Count.ToString()"
                      Note="@(_snapshot.DisconnectedNodes.Count == 0 ? "gone quiet" : string.Join(", ", _snapshot.DisconnectedNodes.Select(NameFor)))"
                      Title="@(_snapshot.DisconnectedNodes.Count == 0 ? null : "No packets from " + string.Join(", ", _snapshot.DisconnectedNodes))"
                      ValueClass="@(_snapshot.DisconnectedNodes.Count > 0 ? "stat-value-warn" : string.Empty)" />
        </div>
    </div>

    <div class="mb-3">
        <button type="button" class="btn btn-link btn-sm p-0" @onclick="() => _showMoreStats = !_showMoreStats">
            @(_showMoreStats ? "Fewer stats" : "More stats")
        </button>
    </div>

    @if (_showMoreStats)
    {
        <div class="row g-3 mb-3">
            <div class="col-6 col-md">
                <StatTile Label="Alert queue" Value="@_snapshot.AlertDepth.ToString()" Note="alerts waiting" />
            </div>
            <div class="col-6 col-md">
                <StatTile Label="Alerts raised" Value="@_snapshot.AlertsRaised.ToString()" Note="since the api started" />
            </div>
            <div class="col-6 col-md">
                <StatTile Label="Packets jumped" Value="@_snapshot.PacketsJumped.ToString()" Note="overtaken by alerts" />
            </div>
            <div class="col-6 col-md">
                <StatTile Label="Suppressed" Value="@_snapshot.SuppressedDuplicates.ToString()" Note="@($"repeat faults not alerted, {_snapshot.SuppressedDisconnects} repeat disconnects")" />
            </div>
            <div class="col-6 col-md">
                <StatTile Label="Undo stack" Value="@_snapshot.UndoDepth.ToString()" Note="overrides that can be undone" />
            </div>
        </div>
    }

    <h2 class="section-title">Devices (@_snapshot.Devices.Count)</h2>

    @if (_snapshot.Devices.Count == 0)
    {
        <div class="card">
            <div class="card-body text-center text-muted py-5">
                @if (!string.IsNullOrWhiteSpace(State.SearchText))
                {
                    <span>No devices match "@State.SearchText".</span>
                }
                else if (State.Category != null || State.AlertsOnly)
                {
                    <span>No devices match the filters.</span>
                }
                else
                {
                    <span>No devices have reported yet. Start the simulator and they will show up here.</span>
                }
            </div>
        </div>
    }
    else
    {
        @* No scrolling wrapper on purpose, the columns shrink and the smaller ones drop away on a narrow screen. *@
        <table class="table table-hover align-middle stream-table">
            <thead>
                <tr>
                    <th class="col-arrow"></th>
                    <th class="col-device">Device</th>
                    <th class="col-latest">Latest</th>
                    <th class="col-signal d-none d-sm-table-cell">Signal</th>
                    <th class="col-seen d-none d-md-table-cell">Last seen</th>
                    <th class="col-valve">Valve</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var device in _snapshot.Devices)
                {
                    var isOpen = device.MacAddress == _historyMac;

                    @* The whole row opens the history. The arrow is the same thing for a keyboard. *@
                    <tr class="device-row @(isOpen ? "table-active" : string.Empty)" @onclick="() => ShowHistoryAsync(device.MacAddress)">
                        <td class="cell-arrow">
                            <button type="button" class="arrow-button" aria-expanded="@(isOpen ? "true" : "false")"
                                    aria-label="@((isOpen ? "Hide history for " : "Show history for ") + device.Name)"
                                    @onclick="() => ShowHistoryAsync(device.MacAddress)" @onclick:stopPropagation="true">
                                <span class="arrow @(isOpen ? "arrow-open" : string.Empty)"></span>
                            </button>
                        </td>
                        <td class="cell-device">
                            <div class="cell-line">
                                <span class="device-name">@device.Name</span>
                                @if (device.Disconnected)
                                {
                                    <span class="status-chip status-chip-silent ms-1">Quiet</span>
                                }
                                @foreach (var fault in device.Faults)
                                {
                                    <span class="status-chip status-chip-spike ms-1">@fault</span>
                                }
                            </div>
                            <div class="cell-line small text-muted font-monospace">@device.MacAddress</div>
                        </td>
                        <td class="font-monospace">@device.Reading</td>
                        <td class="d-none d-sm-table-cell">
                            <div class="cell-line">@(device.Radio.Rssi?.ToString() ?? "-") dBm</div>
                            <div class="cell-line small text-muted">@(device.Radio.Protocol ?? "-"), @(device.Radio.HopCount?.ToString() ?? "-") @(device.Radio.HopCount == 1 ? "hop" : "hops")</div>
                        </td>
                        <td class="text-muted small d-none d-md-table-cell">@device.LastSeen.ToLocalTime().ToString("HH:mm:ss")</td>
                        <td class="text-end">
                            @if (device.Category == SensorCategory.Actuator)
                            {
                                @* The filled side is where the valve is now. Clicking here never opens the history. *@
                                <div class="btn-group btn-group-sm" role="group" aria-label="Override valve @device.Name">
                                    <button type="button" class="btn @(device.State == true ? "btn-primary" : "btn-outline-primary")" disabled="@(_isSending || _loadFailed)"
                                            @onclick="() => SendAsync(device.MacAddress, true)" @onclick:stopPropagation="true">Open</button>
                                    <button type="button" class="btn @(device.State == false ? "btn-primary" : "btn-outline-primary")" disabled="@(_isSending || _loadFailed)"
                                            @onclick="() => SendAsync(device.MacAddress, false)" @onclick:stopPropagation="true">Close</button>
                                </div>
                            }
                        </td>
                    </tr>
                    @if (isOpen)
                    {
                        <tr class="history-row">
                            <td colspan="6" class="p-0 border-0">
                                @HistoryCard
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    }

    @* A filter can hide the open device, and then the card has no row to sit under. *@
    @if (_historyMac != null && !_snapshot.Devices.Any(d => d.MacAddress == _historyMac))
    {
        @HistoryCard
    }
}
</div>
</div>

<aside class="stream-side">
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <BusyButton CssClass="btn btn-outline-secondary btn-sm"
                    Label="Undo last override"
                    BusyLabel="Undoing..."
                    Busy="_isSending"
                    Disabled="_loadFailed"
                    OnClick="UndoAsync" />
        <BusyButton CssClass="btn btn-outline-danger btn-sm"
                    Label="Shut all valves"
                    BusyLabel="Closing..."
                    Busy="_isSending"
                    Disabled="_loadFailed"
                    OnClick="ShutAllAsync" />
    </div>

    <div class="mb-3">
        <SuggestionsPanel Suggestions="_suggestions" Failed="_suggestionsFailed" Disabled="_loadFailed || _isSending" OnApply="ApplySuggestionAsync" />
    </div>
    <UndoPanel Commands="_commands" Failed="_commandsFailed" />
</aside>
</div>

@* Sits over the page, so a message arriving never pushes the table down. *@
@if (_commandMessage != null)
{
    <div class="stream-toast alert @(_commandFailed ? "alert-danger" : "alert-success") shadow" role="status">@_commandMessage</div>
}

@code {
    // The history for the open device, drawn under its row or below the table.
    private RenderFragment HistoryCard => @<div class="card mb-3 history-card" tabindex="-1" @ref="_historyCard">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h2 class="h6 mb-0">History for <span class="font-monospace">@_historyMac</span></h2>
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CloseHistory">Close</button>
            </div>

            <div class="btn-group btn-group-sm mb-2" role="group" aria-label="History range">
                @foreach (var (minutes, label) in HistoryRanges)
                {
                    <button type="button" class="btn @(State.HistoryMinutes == minutes ? "btn-primary" : "btn-outline-primary")"
                            @onclick="() => ChooseRange(minutes)">@label</button>
                }
            </div>

            @if (_historyFailed)
            {
                <div class="alert alert-danger mb-0">Could not load the history for this device.</div>
            }
            else if (_history == null)
            {
                <div class="text-muted">Loading...</div>
            }
            else if (_history.Count == 0)
            {
                <div class="text-muted">
                    @(State.HistoryMinutes == 0 ? "No readings kept for this device yet." : "No readings in this range.")
                </div>
            }
            else
            {
                <div class="mb-2 text-primary">
                    <TimelineChart Points="_history" />
                </div>
                <div class="small text-muted mb-2">Newest @Math.Min(_history.Count, HistoryRows) of @_history.Count in this range.</div>
                <div class="table-responsive">
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr>
                                <th>Recorded</th>
                                <th>Reading</th>
                                <th>RSSI</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var point in _history.AsEnumerable().Reverse().Take(HistoryRows))
                            {
                                <tr>
                                    <td class="text-muted small">@point.RecordedAt.ToLocalTime().ToString("HH:mm:ss")</td>
                                    <td class="font-monospace">@point.Reading</td>
                                    <td>@(point.Rssi?.ToString() ?? "-") dBm</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>;

    private const int DefaultPollMilliseconds = 1000;
    private const int LowestPollMilliseconds = 250;

    // How long a call may take before the page counts the api as unreachable. Hard coded for now.
    private const int RequestTimeoutMilliseconds = 5000;
    private const int HistoryRows = 15;

    // How long a message stays up.
    private const int MessageMilliseconds = 8000;

    // Minutes back from now, where 0 means everything the log kept.
    private static readonly (int Minutes, string Label)[] HistoryRanges =
    {
        (1, "Last minute"),
        (5, "Last 5 minutes"),
        (0, "All kept")
    };

    private int _pollMilliseconds = DefaultPollMilliseconds;

    private StreamSnapshot? _snapshot;
    private bool _loadFailed;
    private CancellationTokenSource? _polling;

    private bool _showMoreStats;

    private bool _isSending;
    private bool _commandFailed;
    private string? _commandMessage;

    private List<CommandSummary>? _commands;
    private bool _commandsFailed;

    private List<Suggestion>? _suggestions;
    private bool _suggestionsFailed;

    private string? _historyMac;
    private List<HistoryPoint>? _history;
    private bool _historyFailed;

    // Set when a card is opened, so the page brings it into view once it has drawn.
    private ElementReference _historyCard;
    private bool _focusHistory;
    private IJSObjectReference? _scroll;

    private CancellationTokenSource? _messageTimeout;

    // The select works in text, the state holds the category itself.
    private string CategoryText
    {
        get => State.Category?.ToString() ?? string.Empty;
        set => State.Category = Enum.TryParse<SensorCategory>(value, out var category) ? category : null;
    }

    private bool FiltersSet => !string.IsNullOrWhiteSpace(State.SearchText) || State.Category != null || State.AlertsOnly;

    // Each setter only raises a change when its value really moves, so this reloads at most three times.
    private void ClearFilters()
    {
        State.SearchText = string.Empty;
        State.Category = null;
        State.AlertsOnly = false;
    }

    protected override async Task OnInitializedAsync()
    {
        // A missing, non-numeric or tiny setting falls back, so a typo cannot hammer the api.
        if (int.TryParse(Config["PollIntervalMilliseconds"], out var configured) && configured >= LowestPollMilliseconds)
        {
            _pollMilliseconds = configured;
        }

        State.OnChange += OnStateChanged;
        State.OnStreamChanged += OnStateChanged;

        await LoadSnapshotAsync();

        _polling = new CancellationTokenSource();

        _ = PollAsync(_polling.Token);

        // Opened after the first load so a slow hub never holds the page up.
        await State.StartAsync();
    }

    // The poll stays as the fallback, and it is also what tries the hub again after the api was down.
    private async Task PollAsync(CancellationToken token)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(_pollMilliseconds));

        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                try
                {
                    if (!State.Connected)
                    {
                        await State.StartAsync();
                    }

                    await ReloadAsync();
                }
                catch (Exception ex) when (ex is not OperationCanceledException)
                {
                    // Whatever went wrong, the loop carries on or the page would stay stale for good.
                    Console.WriteLine($"The stream refresh failed: {ex.GetType().Name}: {ex.Message}");
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    // Every read gets the same short timeout, so a hung api shows as failed in seconds and not after a minute and a half.
    private async Task<T?> GetAsync<T>(string url)
    {
        using var timeout = new CancellationTokenSource(RequestTimeoutMilliseconds);

        return await Http.GetFromJsonAsync<T>(url, ApiJsonOptions.Default, timeout.Token);
    }

    // The page never passes its own token to these calls, so a cancelled one here is the timeout.
    private static bool IsRequestFailure(Exception ex)
    {
        return ex is HttpRequestException or System.Text.Json.JsonException or TaskCanceledException;
    }

    // Loads the list again, and the open history with it, then redraws.
    private async Task ReloadAsync()
    {
        await LoadSnapshotAsync();

        // If the api would not answer for the snapshot it will not for the rest, so show that now instead of waiting on two more timeouts.
        if (_loadFailed)
        {
            await InvokeAsync(StateHasChanged);
            return;
        }

        // Asked for every time, since an undo and a new override between two polls leave the depth the same.
        await LoadCommandsAsync();
        await LoadSuggestionsAsync();

        if (_historyMac != null)
        {
            await LoadHistoryAsync();
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadCommandsAsync()
    {
        try
        {
            _commands = await GetAsync<List<CommandSummary>>("api/commands/history");
            _commandsFailed = false;
        }
        catch (Exception ex) when (IsRequestFailure(ex))
        {
            _commandsFailed = true;
        }
    }

    private async Task LoadSuggestionsAsync()
    {
        try
        {
            _suggestions = await GetAsync<List<Suggestion>>("api/insights");
            _suggestionsFailed = false;
        }
        catch (Exception ex) when (IsRequestFailure(ex))
        {
            _suggestionsFailed = true;
        }
    }

    // A suggestion goes out as an ordinary override, so the message, the undo stack and the engine all see it the usual way.
    private async Task ApplySuggestionAsync(Suggestion suggestion)
    {
        // The event says what the suggestion is, a valve to switch, shut all, undo, a search to repeat or a device to look at.
        if (suggestion.MacAddress != null && suggestion.Open != null)
        {
            await SendAsync(suggestion.MacAddress, suggestion.Open.Value);
        }
        else if (suggestion.Kind == "Problem" && suggestion.MacAddress != null)
        {
            await ShowHistoryAsync(suggestion.MacAddress);
        }
        else if (suggestion.Event == "command:shutall")
        {
            await ShutAllAsync();
        }
        else if (suggestion.Event == "command:undo")
        {
            await UndoAsync();
        }
        else if (suggestion.Event.StartsWith("search:"))
        {
            State.SearchText = suggestion.Event["search:".Length..];
        }
    }

    private async Task ShowHistoryAsync(string macAddress)
    {
        // A second click on the open device hides it.
        if (macAddress == _historyMac)
        {
            CloseHistory();
            return;
        }

        _historyMac = macAddress;
        _history = null;
        _historyFailed = false;
        _focusHistory = true;

        await LoadHistoryAsync();
    }

    // Scrolls to the card and focuses it for keyboard users, the css margin keeps it clear of the sticky bars.
    // It waits for the readings, because a card still saying Loading is short and the page cannot scroll far enough yet.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusHistory && _historyMac != null && _historyCard.Id != null && (_history != null || _historyFailed))
        {
            _focusHistory = false;

            try
            {
                await _historyCard.FocusAsync(preventScroll: true);

                _scroll ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/scroll.js");
                await _scroll.InvokeVoidAsync("scrollToElement", _historyCard);
            }
            catch (JSException ex)
            {
                // The card is still on the page, only the scroll is lost.
                Console.WriteLine($"Could not scroll to the history: {ex.Message}");
            }
        }
    }

    // Names a quiet device for the tile, or gives its mac when a filter has hidden it from the list.
    private string NameFor(string macAddress)
    {
        return _snapshot?.Devices.FirstOrDefault(d => d.MacAddress == macAddress)?.Name ?? macAddress;
    }

    // Takes the message down after a while, a newer message restarts the wait.
    private async Task ClearMessageLaterAsync()
    {
        _messageTimeout?.Cancel();
        _messageTimeout?.Dispose();

        var source = new CancellationTokenSource();
        _messageTimeout = source;

        try
        {
            await Task.Delay(MessageMilliseconds, source.Token);

            _commandMessage = null;
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void CloseHistory()
    {
        _historyMac = null;
        _history = null;
    }

    private async Task LoadHistoryAsync()
    {
        var mac = _historyMac;

        var minutes = State.HistoryMinutes;

        try
        {
            var url = $"api/stream/devices/{Uri.EscapeDataString(mac!)}/history";

            // The api does the narrowing, so the page only ever receives the range it draws.
            if (minutes > 0)
            {
                var from = DateTime.UtcNow.AddMinutes(-minutes).ToString("o");
                url += $"?from={Uri.EscapeDataString(from)}";
            }

            var points = await GetAsync<List<HistoryPoint>>(url);

            // The card may have been closed, switched or given another range while the call was out.
            if (mac != _historyMac || minutes != State.HistoryMinutes)
            {
                return;
            }

            _history = points ?? new List<HistoryPoint>();
            _historyFailed = false;
        }
        catch (Exception ex) when (IsRequestFailure(ex))
        {
            _historyFailed = true;
        }
    }

    // Changing the range raises OnChange, which reloads the page and the card with it.
    private void ChooseRange(int minutes)
    {
        if (State.HistoryMinutes != minutes)
        {
            _history = null;
        }

        State.HistoryMinutes = minutes;
    }

    private async Task LoadSnapshotAsync()
    {
        try
        {
            var url = $"api/stream/snapshot?search={Uri.EscapeDataString(State.SearchText)}&alertsOnly={State.AlertsOnly.ToString().ToLowerInvariant()}";

            if (State.Category != null)
            {
                url += $"&category={State.Category}";
            }

            _snapshot = await GetAsync<StreamSnapshot>(url);
            _loadFailed = false;
        }
        catch (Exception ex) when (IsRequestFailure(ex))
        {
            _loadFailed = true;
        }
    }

    private async Task SendAsync(string macAddress, bool open)
    {
        var request = new PumpCommandRequest { MacAddress = macAddress, Open = open };

        await PostCommandAsync(token => Http.PostAsJsonAsync("api/commands", request, ApiJsonOptions.Default, token));
    }

    private async Task ShutAllAsync()
    {
        await PostCommandAsync(token => Http.PostAsync("api/commands/close-all", null, token));
    }

    private async Task UndoAsync()
    {
        await PostCommandAsync(token => Http.PostAsync("api/commands/undo", null, token));
    }

    private async Task PostCommandAsync(Func<CancellationToken, Task<HttpResponseMessage>> post)
    {
        _isSending = true;
        _commandFailed = false;

        using var timeout = new CancellationTokenSource(RequestTimeoutMilliseconds);

        try
        {
            var response = await post(timeout.Token);

            _commandMessage = await response.Content.ReadAsStringAsync();
            _commandFailed = !response.IsSuccessStatusCode;

            await LoadSnapshotAsync();
            await LoadCommandsAsync();
            await LoadSuggestionsAsync();

            _ = ClearMessageLaterAsync();
        }
        catch (Exception ex) when (IsRequestFailure(ex))
        {
            // A call that timed out may still have reached the api, so it is not said to have failed outright.
            _commandMessage = ex is TaskCanceledException
                ? "The gateway did not answer in time. The override may still have gone through, check before sending it again."
                : "Could not reach the gateway API.";
            _commandFailed = true;

            _ = ClearMessageLaterAsync();
        }
        finally
        {
            _isSending = false;
        }
    }

    // A filter changed or the api pushed, so the list is asked for again straight away.
    private void OnStateChanged()
    {
        _ = ReloadAsync();
    }

    public void Dispose()
    {
        State.OnChange -= OnStateChanged;
        State.OnStreamChanged -= OnStateChanged;
        _polling?.Cancel();
        _polling?.Dispose();
        _messageTimeout?.Cancel();
        _messageTimeout?.Dispose();

        if (_scroll != null)
        {
            _ = _scroll.DisposeAsync().AsTask();
        }
    }
}
